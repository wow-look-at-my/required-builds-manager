{
	"name": "required-builds-manager",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"observability": {
		"traces": {
			"enabled": true,
			"destinations": ["otel-traces"],
			"head_sampling_rate": 1
		},
		"logs": {
			"enabled": true,
			"destinations": ["otel-logs"],
			"head_sampling_rate": 1
		}
	}
}
